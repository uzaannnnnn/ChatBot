# Backend API Base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8080

# Optional explicit frontend origin for Supabase email confirmation redirects
# (defaults to window.location.origin at runtime; set to https://doubleu-ai.eshace.com in production)
# VITE_SITE_URL=https://doubleu-ai.eshace.com

# Supabase Project URL and Public Anon Key (safe for browser bundle)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your_supabase_anon_key_here
