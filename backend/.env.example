# Application Environment (development | staging | production)
APP_ENV=development

# HTTP Server Port
APP_PORT=8080

# Supabase PostgreSQL Session Pooler Connection String (SSL required)
DATABASE_URL=postgresql://postgres.project_ref:your_password@aws-0-region.pooler.supabase.com:5432/postgres?sslmode=require

# Supabase Auth Configuration (JWT Verification)
SUPABASE_URL=https://your-project-ref.supabase.co
# Optional explicit JWKS override (defaults to ${SUPABASE_URL}/auth/v1/.well-known/jwks.json)
# SUPABASE_JWKS_URL=
# Optional legacy HS256 JWT secret (prefer JWKS asymmetric verification)
# SUPABASE_JWT_SECRET=

# Supabase Private Storage Configuration (Backend-only; NEVER expose to frontend)
# Required for saving generated images and minting short-lived signed URLs.
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key_here
SUPABASE_STORAGE_BUCKET=chat-attachments
SIGNED_URL_TTL=15m

# Allowed Frontend CORS Origin
FRONTEND_ORIGIN=http://localhost:5173

# Optional: Dedicated PostgreSQL URL for running integration tests (-tags=integration)
# TEST_DATABASE_URL=postgresql://postgres:postgres@localhost:5432/chatbot_test?sslmode=disable

# Active AI Provider Selection (gemini | huggingface)
AI_PROVIDER=gemini

# Google Gemini API Configuration (Primary text & tool orchestration model)
# GEMINI_API_KEY: API Key from Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL_ID=gemini-3.1-flash-lite
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta

# Cloudflare Workers AI Configuration (Native image generation with FLUX.1 schnell)
# Backend-only credentials; NEVER expose to Vite or browser.
CLOUDFLARE_ACCOUNT_ID=your_cloudflare_account_id_here
CLOUDFLARE_API_TOKEN=your_cloudflare_api_token_here
CLOUDFLARE_BASE_URL=https://api.cloudflare.com/client/v4
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
IMAGE_GEN_TIMEOUT=45s

# AI Generation Parameters
AI_MAX_OUTPUT_TOKENS=2048
AI_TEMPERATURE=0.7
AI_TIMEOUT=60s
AI_MAX_CONTEXT_MESSAGES=20
AI_SYSTEM_PROMPT=You are DOUBLEU AI, a helpful, thoughtful, and honest general-purpose AI assistant. When the user asks you to generate, draw, or create an image, invoke the generate_image tool rather than outputting raw JSON.

# ------------------------------------------------------------------------------
# Optional: Hugging Face Inference Provider (only needed when AI_PROVIDER=huggingface)
# ------------------------------------------------------------------------------
# HF_TOKEN=hf_your_token_here
# HF_MODEL_ID=meta-llama/Llama-3.3-70B-Instruct
# HF_BASE_URL=https://router.huggingface.co/v1
# HF_PROVIDER=auto
